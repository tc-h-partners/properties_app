generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  INVESTMENT
  OWNER_OCCUPIED
}

enum EntityType {
  INDIVIDUAL
  JOINT
  FAMILY_TRUST
  UNIT_TRUST
  COMPANY
  SMSF
}

enum SnapshotPoint {
  EOFY
  REVIEW_DATE
}

enum WorkflowStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CriterionPriority {
  HIGH
  MEDIUM
  LOW
  MONITOR
}

enum CriterionRating {
  STRONG
  SATISFACTORY
  ATTENTION_REQUIRED
  CRITICAL
}

model Adviser {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  firmName         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  households       ClientHousehold[]

  @@map("advisers")
}

model ClientHousehold {
  id                   String            @id @default(uuid())
  adviserId            String
  householdName        String
  adviserAssigned      String?           @default("Sarah Jenkins (Senior Property CFO)")
  primaryContactEmail  String            @default("")
  primaryContactPhone  String?
  notes                String?
  executiveReport      String?           @default("Locked (Pending Review)")
  householdExpenditure Decimal           @default(0)
  creditCardLimit      Decimal           @default(0)
  otherLiabilities     Decimal           @default(0)
  monthlyPayments      Decimal           @default(0)
  borrowingCapacity    Decimal           @default(0)
  cashSavings          Decimal           @default(0)
  isArchived           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  adviser              Adviser           @relation(fields: [adviserId], references: [id], onDelete: Cascade)
  members              Person[]
  entities             OwnershipEntity[]
  properties           Property[]
  reviews              AnnualReview[]

  @@map("client_households")
}

model Person {
  id                      String          @id @default(uuid())
  householdId             String
  firstName               String
  lastName                String
  dob                     DateTime?
  age                     String?
  phone                   String?
  email                   String?
  annualSalary            Decimal         @default(0)
  expectedRetirementAge   Int?            @default(65)
  currentSuperBalance     Decimal         @default(0)
  annualSuperContribution Decimal         @default(0)
  marginalTaxRate         Decimal         @default(0.3700)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  household               ClientHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("people")
}

model OwnershipEntity {
  id              String          @id @default(uuid())
  householdId     String
  name            String
  type            EntityType
  displayType     String?
  abnOrTfnMasked  String?
  ageOrDob        String?         @default("---")
  phone           String?
  email           String?
  annualSalary    Decimal         @default(0)
  marginalTaxRate Decimal         @default(0.3700)
  superBalance    Decimal         @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  household       ClientHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  properties      Property[]

  @@map("ownership_entities")
}

model Property {
  id               String                      @id @default(uuid())
  householdId      String
  entityId         String?
  name             String
  address          String
  suburb           String                      @default("")
  state            String                      @default("NSW")
  postcode         String                      @default("2000")
  propertyCategory String                      @default("House")
  type             PropertyType                @default(INVESTMENT)
  purposeDisplay   String?                     @default("Investment")
  purchaseDate     DateTime                    @default(now())
  purchaseDateStr  String?
  purchasePrice    Decimal                     @default(0)
  acquisitionCosts Decimal                     @default(45936)
  currentValuation Decimal                     @default(0)
  weeklyRent       Decimal                     @default(0)
  landSize         String?                     @default("600")
  beds             Int                         @default(4)
  baths            Int                         @default(2)
  cars             Int                         @default(2)
  owner1           String?                     @default("Primary Owner")
  owner1Pct        String?                     @default("100%")
  owner2           String?                     @default("----")
  owner2Pct        String?                     @default("---")
  ownersJson       Json?
  soldDate         String?
  isActive         Boolean                     @default(true)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  household        ClientHousehold             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entity           OwnershipEntity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  loans            Loan[]
  snapshots        PropertyFinancialSnapshot[]

  @@map("properties")
}

model Loan {
  id                String                  @id @default(uuid())
  propertyId        String
  lender            String
  accountName       String
  loanReference     String?
  isTchLoan         Boolean                 @default(true)
  purpose           String?                 @default("Investment")
  repaymentType     String?                 @default("Interest only")
  rateType          String?                 @default("Variable")
  loanType          String                  @default("IO")
  ioExpiry          String?                 @default("----")
  fixedExpiry       String?                 @default("----")
  maturityDate      String?                 @default("24/10/2026")
  security1         String?
  security2         String?                 @default("----")
  security3         String?                 @default("----")
  isClosed          Boolean                 @default(false)
  closedDate        String?
  isOffsetAvailable Boolean                 @default(true)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  property          Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  snapshots         LoanFinancialSnapshot[]

  @@map("loans")
}

model AnnualReview {
  id                         String                      @id @default(uuid())
  householdId                String
  financialYear              Int
  reviewDate                 DateTime?
  reviewDateStr              String?
  finDataStatus              WorkflowStatus              @default(IN_PROGRESS)
  tchReviewStatus            WorkflowStatus              @default(NOT_STARTED)
  completedAt                DateTime?
  executiveSummary           String?
  verdictText                String?
  objectiveText              String?
  portfolioCommentary        String?
  propertyCommentary         String?
  bottomLineText             String?
  shareChannel               String?                     @default("Launch")
  complianceAcknowledged     String?                     @default("-")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  household                  ClientHousehold             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  propertySnapshots          PropertyFinancialSnapshot[]
  loanSnapshots              LoanFinancialSnapshot[]
  criteria                   AssessmentCriterion[]
  futureOutlook              FutureOutlookScenario?
  reportSnapshot             ReportSnapshot?

  @@unique([householdId, financialYear])
  @@map("annual_reviews")
}

model PropertyFinancialSnapshot {
  id                     String        @id @default(uuid())
  annualReviewId         String
  propertyId             String
  snapshotPoint          SnapshotPoint
  valuation              Decimal       @default(0)
  weeklyRent             Decimal       @default(0)
  marketWeeklyRent       Decimal       @default(0)
  annualGrossRent        Decimal       @default(0)
  vacancyWeeks           Decimal       @default(0)
  councilRates           Decimal       @default(0)
  waterRates             Decimal       @default(0)
  insurance              Decimal       @default(0)
  propertyManagementFees Decimal       @default(0)
  repairsMaintenance     Decimal       @default(0)
  landTax                Decimal       @default(0)
  strataFees             Decimal       @default(0)
  otherExpenses          Decimal       @default(0)
  depreciationNonCash    Decimal       @default(0)
  status                 String        @default("Not Started")
  detailsJson            Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  annualReview           AnnualReview  @relation(fields: [annualReviewId], references: [id], onDelete: Cascade)
  property               Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([annualReviewId, propertyId, snapshotPoint])
  @@map("property_financial_snapshots")
}

model LoanFinancialSnapshot {
  id               String        @id @default(uuid())
  annualReviewId   String
  loanId           String
  snapshotPoint    SnapshotPoint
  loanBalance      Decimal       @default(0)
  offsetBalance    Decimal       @default(0)
  interestRate     Decimal       @default(0.0595)
  marketRate       Decimal       @default(0.0605)
  annualRepayments Decimal       @default(0)
  interestPaid     Decimal       @default(0)
  loanLimit        Decimal       @default(0)
  status           String        @default("Not Started")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  annualReview     AnnualReview  @relation(fields: [annualReviewId], references: [id], onDelete: Cascade)
  loan             Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([annualReviewId, loanId, snapshotPoint])
  @@map("loan_financial_snapshots")
}

model AssessmentCriterion {
  id                     String             @id @default(uuid())
  annualReviewId         String
  category               String             @default("PROPERTY_ANALYSIS")
  criterionCode          String             @default("CUSTOM_INSIGHT")
  criterionTitle         String
  screen                 String?            @default("Property Analysis")
  propertyName           String?            @default("Portfolio-Wide")
  maintenanceInsight     String?            @default("-")
  metric                 String?            @default("Rental Income")
  owner                  String?            @default("Adviser")
  action                 String?            @default("Review")
  calculatedEvidenceJson Json?
  rating                 CriterionRating?
  insight                String?
  recommendation         String?
  potentialOpportunity   String?
  priority               CriterionPriority? @default(MEDIUM)
  adviserNotes           String?
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  annualReview           AnnualReview       @relation(fields: [annualReviewId], references: [id], onDelete: Cascade)

  @@map("assessment_criteria")
}

model FutureOutlookScenario {
  id                             String       @id @default(uuid())
  annualReviewId                 String       @unique
  forecastYears                  Int          @default(20)
  propertyGrowthRate             Decimal      @default(0.0400)
  rentalGrowthRate               Decimal      @default(0.0350)
  inflationRate                  Decimal      @default(0.0250)
  superReturnRate                Decimal      @default(0.0700)
  extraMonthlyHomeLoanRepayment  Decimal      @default(0)
  downsizeEnabled                Boolean      @default(false)
  downsizeYearOffset             Int?         @default(10)
  downsizeNetProceedsToSuper     Decimal?     @default(800000)
  targetRetirementIncomeAfterTax Decimal      @default(120000)
  assumptionsJson                Json?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  annualReview                   AnnualReview @relation(fields: [annualReviewId], references: [id], onDelete: Cascade)

  @@map("future_outlook_scenarios")
}

model ReportSnapshot {
  id             String       @id @default(uuid())
  annualReviewId String       @unique
  snapshotData   Json
  generatedAt    DateTime     @default(now())
  annualReview   AnnualReview @relation(fields: [annualReviewId], references: [id], onDelete: Cascade)

  @@map("report_snapshots")
}

model MarketBenchmark {
  id                     String   @id @default(uuid())
  effectiveDate          DateTime
  state                  String?
  suburb                 String?
  propertyCategory       String?
  benchmarkInterestRate  Decimal?
  benchmarkGrossYield    Decimal?
  benchmarkWeeklyRent    Decimal?
  benchmarkRentalGrowth  Decimal?
  benchmarkCapitalGrowth Decimal?
  asxIndexValue          Decimal?
  sourceNotes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("market_benchmarks")
}

model PublicEnquiry {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String?
  enquiryType String
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("public_enquiries")
}
