            "body": {
              "mode": "raw",
              "raw": "{\n  \"snapshots\": [\n    {\n      \"propertyId\": \"{{propertyId}}\",\n      \"snapshotPoint\": \"REVIEW_DATE\",\n      \"valuation\": 1100000,\n      \"weeklyRent\": 850,\n      \"annualGrossRent\": 44200,\n      \"vacancyWeeks\": 1,\n      \"councilRates\": 1600,\n      \"waterRates\": 850,\n      \"insurance\": 1350,\n      \"propertyManagementFees\": 2652,\n      \"repairsMaintenance\": 900,\n      \"landTax\": 0,\n      \"strataFees\": 3200,\n      \"otherExpenses\": 300,\n      \"depreciationNonCash\": 6500\n    }\n  ]\n}"
